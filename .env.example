# HourBoost — Ortam Değişkenleri Örneği
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldurun. ".env" repoya
# COMMIT EDİLMEZ (.gitignore'da). Üretimde tüm zorunlu alanları doldurun.

# ── ZORUNLU ───────────────────────────────────────────────────────
# Flask oturum/JWT imzalama anahtarı. Güçlü ve rastgele olmalı.
# Üret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ── Steam ─────────────────────────────────────────────────────────
# Steam Web API anahtarı (server-side profil/avatar fallback'i için).
# Steam OpenID doğrulaması, CM login ve boost motoru bu key'e bağlı değildir.
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Profil verisi once bagli CM worker'dan, sonra Web API'den alinir. Asagidaki
# degerler API/Community kesintilerinde request ve log firtinasini sinirlar.
STEAM_PROFILE_CACHE_TTL_SECONDS=900
STEAM_PROFILE_STALE_TTL_SECONDS=86400
STEAM_PROFILE_FAILURE_COOLDOWN_SECONDS=60
STEAM_PROFILE_AUTH_COOLDOWN_SECONDS=3600
STEAM_PROFILE_CACHE_MAX_ENTRIES=500
# Deprecated public XML yalniz son care fallback'tir. Gecerli API key ve CM
# persona yolu dogrulandiktan sonra production'da false yapilabilir.
STEAM_PROFILE_XML_FALLBACK_ENABLED=true
# İsteğe bağlı: encrypted credential ve account-isolated steam-user verilerinin
# kökü. Boşsa uygulama dizini kullanılır (tokens/ ve sentry/ burada oluşur).
STEAM_STATE_DIR=
# İsteğe bağlı Node.js binary yolu; boşsa PATH üzerindeki "node" kullanılır.
NODE_BIN=
# Maximum accepted lead of durable boost accounting timestamps over wall UTC.
# Exceeding it fails startup instead of silently granting quota (default 7d).
ACCOUNTING_CLOCK_MAX_FUTURE_SECONDS=604800

# ── Genel ─────────────────────────────────────────────────────────
# Sitenin tam adresi (Steam OpenID return_to ve mail linkleri için).
SITE_URL=https://hourboost.com.tr

# Flask/Werkzeug genel istek gövdesi limiti (byte). Varsayılan 512 KiB.
# Reverse proxy kullanılıyorsa nginx client_max_body_size değeri de 512k veya
# daha düşük tutulmalıdır.
MAX_CONTENT_LENGTH_BYTES=524288

# Veritabanı bağlantısı. Mevcut tek-worker kurulum SQLite ile çalışır ve
# uygulama bunu başlangıçta açıkça uyarı olarak loglar. PostgreSQL/Redis ve
# multi-worker geçişi henüz tamamlanmamış Phase 5H kapsamındadır; uygun DB
# sürücüsü ve migration provası olmadan bu URL'yi PostgreSQL'e çevirmeyin.
# Gelecekteki hedef: postgresql+psycopg2://kullanici:sifre@host:5432/hourboost
DATABASE_URL=sqlite:///steamboost.db

# Rate limit deposu. Tek worker'da memory:// yeterli. ÜRETİMDE (özellikle
# birden fazla worker/sunucuya ölçeklerken) ZORUNLU olarak Redis kullanın:
# redis://localhost:6379
LIMITER_STORAGE_URI=memory://

# ── Kimlik Şifreleme ──────────────────────────────────────────────
# Steam parolalarını diskte şifrelemek için Fernet anahtarı.
# AYARLANMAZSA SECRET_KEY'den türetilir; SECRET_KEY değişirse kayıtlı
# kimlikler çözülemez hale gelir — bu yüzden ÜRETİMDE MUTLAKA AYARLAYIN.
# Üret: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRED_KEY=

# ── E-posta (Gmail SMTP) ──────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ── Shopier (Ödeme) ───────────────────────────────────────────────
# Webhook imza doğrulaması için zorunlu. Bu token PAT değildir.
SHOPIER_WEBHOOK_SECRET=
# Shopier API çağrıları için zorunlu Personal Access Token.
SHOPIER_PAT=
# GET /webhooks ve API response header'ından doğrulanan mağaza/abonelik ID'leri.
SHOPIER_ACCOUNT_ID=
SHOPIER_WEBHOOK_ID=
# Webhook yalnız kuyruğa yazar; worker API üzerinden doğruladıktan sonra plan açar.
SHOPIER_API_VERIFY_ENABLED=false
SHOPIER_VERIFICATION_WORKER_ENABLED=false
# Aktif HB checkout kodunun geçerlilik süresi.
SHOPIER_CHECKOUT_TTL_HOURS=24
# Plan ürün ID'leri (Shopier panelinden).
SHOPIER_BASIC_PRODUCT_ID=45175746
SHOPIER_PREMIUM_PRODUCT_ID=45175760
